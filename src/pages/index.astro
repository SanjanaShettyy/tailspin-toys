---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form method="get" action="/" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <fieldset>
          <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>
          <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
            <div>
              <span class="mb-3 block text-sm font-medium text-slate-300">Categories</span>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                      data-testid={`category-filter-${category.id}`}
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-300">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <a
              href="/"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </a>
            <output class="text-sm text-slate-400" aria-live="polite" data-testid="filter-results-count"></output>
          </div>
        </fieldset>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <p class="hidden py-12 text-center text-slate-300" data-testid="no-filter-results">
          No games match the selected filters.
        </p>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLOutputElement>('[data-testid="filter-results-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (form && resultCount) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';

    form.querySelectorAll<HTMLInputElement>('input[name="category"]').forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });

    const publisherSelect = form.querySelector<HTMLSelectElement>('select[name="publisher"]');
    if (publisherSelect) {
      publisherSelect.value = selectedPublisher;
    }

    const visibleCards = cards.filter((card) => {
      const categoryMatches = selectedCategories.size === 0
        || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches = selectedPublisher === ''
        || card.dataset.publisherId === selectedPublisher;
      card.hidden = !categoryMatches || !publisherMatches;
      return categoryMatches && publisherMatches;
    });

    resultCount.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? 'game' : 'games'} found`;
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCards.length > 0);
    }
  }
</script>
